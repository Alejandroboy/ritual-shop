# ===== Корневой .env =====
# Читается docker-compose.yml и docker-compose.development.yml.
# В прод-compose этот же файл передаётся контейнеру api (env_file: .env), поэтому
# ниже, после переменных инфраструктуры, — полный список переменных API из apps/api/.env.example.
# Реальный файл — .env (в .gitignore).

# --- Инфраструктура (docker compose) ---
# Имя базы Postgres
POSTGRES_DB=
# Пользователь Postgres
POSTGRES_USER=
# [required] Пароль Postgres — длинный случайный, не переиспользовать
POSTGRES_PASSWORD=
# Порт Postgres на хосте (напр. 5433, чтобы не конфликтовать с локальным)
POSTGRES_HOST_PORT=
# Порт Redis на хосте (напр. 6380)
REDIS_HOST_PORT=
# Порт SMTP MailHog на хосте (dev)
MAILHOG_SMTP_PORT=
# Порт веб-интерфейса MailHog на хосте (dev)
MAILHOG_UI_PORT=

# --- Приложение ---
# development | production | test (по умолчанию development)
NODE_ENV=
# Порт HTTP-сервера (по умолчанию 3001)
PORT=
# [required] Публичный адрес сайта, используется в ссылках в письмах и Telegram, напр. https://example.org
PUBLIC_WEB_URL=

# --- База данных и очереди ---
# [required] postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public (локально — контейнер из docker-compose.development.yml)
# В прод-compose для контейнера api перекрывается значением из docker-compose.yml (собирается из POSTGRES_*)
DATABASE_URL=
# Хост Redis для BullMQ и health-check (по умолчанию 127.0.0.1)
REDIS_HOST=
# Порт Redis (по умолчанию 6379)
REDIS_PORT=

# --- Авторизация ---
# [required] Секрет подписи JWT, не короче 32 символов (openssl rand -base64 48)
JWT_SECRET=
# TTL токена модуля админки, секунды (по умолчанию 900)
JWT_EXPIRES=
# TTL access-токена админки, секунды (по умолчанию 3600)
JWT_ACCESS_EXPIRES=
# TTL refresh-токена админки, секунды (по умолчанию 2592000)
JWT_REFRESH_EXPIRES=
# Срок жизни cookie access_token админки, минуты (по умолчанию 60 при логине, 15 при обновлении)
ADMIN_ACCESS_TTL_MIN=
# Срок жизни cookie refresh_token админки, дни (по умолчанию 14)
ADMIN_REFRESH_TTL_DAYS=
# [required] Email администратора: получатель уведомлений по заказам; логин для prisma/seed-admin.ts
ADMIN_EMAIL=
# Пароль первого администратора — нужен только для prisma/seed-admin.ts, не меньше 12 символов
ADMIN_PASSWORD=
# JSON с SLA по статусам для статистики, напр. {"ACCEPTED":"2d"} (необязательно)
ADMIN_SLA_JSON=

# --- Файлы (S3-совместимое хранилище) ---
# [required] Адрес S3 API, напр. https://s3.example.com
S3_ENDPOINT=
# [required] Имя бакета
S3_BUCKET=
# [required] Ключ доступа S3
S3_ACCESS_KEY=
# [required] Секретный ключ S3
S3_SECRET_KEY=
# Регион S3 (по умолчанию ru-1)
S3_REGION=
# Время жизни presigned-ссылок, секунды (по умолчанию 18000)
PRESIGN_EXPIRES=
# Базовый URL для файлов с локальным хранилищем (по умолчанию пусто)
UPLOADS_PUBLIC_BASE=

# --- Интеграции ---
# [required] Токен API МойСклад
MOYSKLAD_TOKEN=
# [required] API-ключ DaData (подсказки по ИНН)
DADATA_API_KEY=
# [required] Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=
# [required] Username бота без @, для ссылки подписки t.me/<username>
TELEGRAM_BOT_USERNAME=
# [required] Секрет вебхука (secret_token в setWebhook) и ключ подписи ссылок: 1–256 символов A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=

# --- Почта ---
# smtp | ethereal | json (по умолчанию smtp)
MAIL_MODE=
# [required] SMTP-хост (локально — MailHog, 127.0.0.1)
SMTP_HOST=
# SMTP-порт (по умолчанию 1025 для писем клиентам, 587 для MailerService)
SMTP_PORT=
# true — TLS с самого начала соединения (порт 465)
SMTP_SECURE=
# true — требовать STARTTLS
SMTP_REQUIRE_TLS=
# Логин SMTP (если сервер требует авторизацию)
SMTP_USER=
# Пароль SMTP
SMTP_PASS=
# Адрес отправителя писем клиентам (по умолчанию no-reply@example.com)
SMTP_FROM=
# Адрес отправителя писем MailerService (по умолчанию SMTP_USER)
MAIL_FROM=
# Email менеджера для уведомлений о новых заказах (необязательно)
MANAGER_EMAIL=
