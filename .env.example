# ===== Корневой .env =====
# Читается docker-compose.yml и docker-compose.development.yml.
# В прод-compose этот же файл передаётся контейнеру api (env_file: .env), поэтому
# ниже, после переменных инфраструктуры, — полный список переменных API из apps/api/.env.example.
# Реальный файл — .env (в .gitignore).
#
# Значения ниже — удобный шаблон. Секреты помечены CHANGE_ME / сгенерируй сам.

# --- Инфраструктура (docker compose) ---
POSTGRES_DB=ritual
POSTGRES_USER=ritual
# [required] длинный случайный пароль
POSTGRES_PASSWORD=CHANGE_ME
# Порт Postgres на хосте (не конфликтовать с локальным 5432)
POSTGRES_HOST_PORT=5433
# Порт Redis на хосте
REDIS_HOST_PORT=6380
# MailHog (dev)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- Приложение ---
NODE_ENV=development
PORT=3001
# [required] публичный URL сайта (письма, Telegram).
# локально: http://localhost:3000
PUBLIC_WEB_URL=https://ritual.alejandrogroup.org

# --- База данных и очереди ---
# [required] локально — хост + POSTGRES_HOST_PORT. В прод-compose для api перекрывается на @db:5432
DATABASE_URL=postgresql://ritual:CHANGE_ME@localhost:5433/ritual?schema=public
# Для yarn dev на хосте:
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
# В Docker-сети api: REDIS_HOST=redis и REDIS_PORT=6379

# --- Авторизация ---
# [required] openssl rand -base64 48  (≥ 32 символов)
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG_____
# секунды
JWT_EXPIRES=900
JWT_ACCESS_EXPIRES=3600
JWT_REFRESH_EXPIRES=2592000
# минуты / дни для cookie админки
ADMIN_ACCESS_TTL_MIN=60
ADMIN_REFRESH_TTL_DAYS=14
# [required] получатель уведомлений + логин для seed-admin
ADMIN_EMAIL=admin@ritual.alejandrogroup.org
# только для prisma/seed-admin.ts (≥ 12 символов), в рантайме API не обязателен
ADMIN_PASSWORD=CHANGE_ME_12chars
# необязательно
ADMIN_SLA_JSON={"DRAFT":"1d","ACCEPTED":"2d","IN_PROGRESS":"7d","APPROVAL":"2d","COMPLETED":"5d"}

# --- Файлы (S3-совместимое хранилище) ---
# [required] ключи ACCESS/SECRET — только в реальном .env, не сюда
S3_ENDPOINT=https://s3.twcstorage.ru
S3_BUCKET=6a3cfea6-c174-4437-ba60-8df848ab0ff4
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_REGION=ru-1
PRESIGN_EXPIRES=18000
UPLOADS_PUBLIC_BASE=

# --- Интеграции ---
MOYSKLAD_TOKEN=CHANGE_ME
DADATA_API_KEY=CHANGE_ME
TELEGRAM_BOT_TOKEN=CHANGE_ME
# username без @
TELEGRAM_BOT_USERNAME=ritual_123_bot
# 1–256 символов A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME

# --- Почта ---
MAIL_MODE=smtp
# локально — MailHog; в Docker-сети api → SMTP_HOST=mailhog
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ritual Shop <noreply@ritual.alejandrogroup.org>
MAIL_FROM=Ritual Shop <noreply@ritual.alejandrogroup.org>
MANAGER_EMAIL=
