// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ====== ENUMS ======
enum Material {
  CERMET
  WHITE_CERAMIC_GRANITE
  BLACK_CERAMIC_GRANITE
  GLASS
  GROWTH_PHOTOCERAMICS
  ENGRAVING
}

enum Shape {
  RECTANGLE
  OVAL
  ARCH
  STAR
  HEART
}

enum Orientation {
  VERTICAL
  HORIZONTAL
}

enum ColorMode {
  BW
  COLOR
}

enum Coverage {
  NORMAL
  FULL_WRAP
}

enum HolePattern {
  NONE
  TWO_HORIZONTAL
  TWO_VERTICAL
  FOUR_CORNERS
}

enum Finish {
  MATTE
  GLOSS
}

enum AssetKind {
  PHOTO
  REFERENCE
  DOCUMENT
}

enum OrderStatus {
  CANCELLED
  DRAFT
  ACCEPTED
  IN_PROGRESS
  APPROVAL
  COMPLETED
  READY
}

enum Currency {
  KZT
  RUB
}

enum Role {
  ADMIN_GOD
  ADMIN
  MANAGER
  CUSTOMER
}

enum StorageType {
  local
  s3
}

enum NotifyChannel {
  TELEGRAM
  WHATSAPP
}

enum AssetStage {
  ORIGINAL
  RETOUCHED
}

enum PendingUploadStatus {
  PENDING
  ATTACHED
  DELETED
  FAILED
}

enum ApprovalStage {
  NOT_STARTED
  IN_PROGRESS
  APPROVED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

// ====== СПРАВОЧНИКИ ======
model Size {
  id         Int    @id @default(autoincrement())
  widthCm    Int
  heightCm   Int
  label      String
  priceMinor Int    @default(0)

  allowedForTemplates TemplateSize[]
  OrderItem           OrderItem[]
  finishPrices        TemplateSizeFinishPrice[]

  @@unique([widthCm, heightCm])
  @@index([heightCm, widthCm])
}

model Frame {
  id   Int    @id @default(autoincrement())
  code Int    @unique
  name String

  allowedForTemplates TemplateFrame[]
  OrderItem           OrderItem[]
}

model Background {
  id   Int    @id @default(autoincrement())
  code Int    @unique
  name String

  allowedForTemplates TemplateBackground[]
  OrderItem           OrderItem[]
}

// ====== КАТАЛОГ ШАБЛОНОВ ======

model Template {
  id        Int    @id @default(autoincrement())
  code      String  @unique
  label     String
  fullTitle String?

  material     Material
  shape        Shape
  orientation  Orientation?
  colorMode    ColorMode
  coverage     Coverage     @default(NORMAL)
  perHolePrice Int          @default(0)
  inscribed    Boolean?
  requiresAsset Boolean?

  supportsFrame      Boolean @default(false)
  requiresBackground Boolean @default(false)
  requiresFinish     Boolean @default(false)
  supportsHoles      Boolean @default(true)

  personsMin Int @default(1)
  personsMax Int @default(1)

  notes        String?
  singlePerson Boolean @default(true)

  allowedSizes       TemplateSize[]
  allowedHoles       TemplateHole[]
  allowedFrames      TemplateFrame[]
  allowedBackgrounds TemplateBackground[]
  allowedFinishes    TemplateFinish[]
  finishPrices       TemplateSizeFinishPrice[]
  goldTypes          TemplateGoldType[]

  items OrderItem[]

  variants TemplateVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([material, shape])
  @@index([colorMode])
}

model TemplateSize {
  templateId           Int
  sizeId               Int
  availableHolePattern HolePattern[] @default([])
  price                Int           @default(0)
  template             Template      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  skuCode              String?
  size                 Size          @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  @@id([templateId, sizeId])
}

model TemplateHole {
  templateId Int
  pattern    HolePattern

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([templateId, pattern])
}

model TemplateFrame {
  templateId Int
  frameId    Int

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  frame    Frame    @relation(fields: [frameId], references: [id], onDelete: Restrict)

  @@id([templateId, frameId])
}

model TemplateBackground {
  templateId   Int
  backgroundId Int

  template   Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  background Background @relation(fields: [backgroundId], references: [id], onDelete: Restrict)

  @@id([templateId, backgroundId])
}

model TemplateFinish {
  templateId Int
  finish     Finish

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([templateId, finish])
}

model TemplateGoldType {
  templateId Int
  goldType   String
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([templateId,goldType])
}

model TemplateVariant {
  templateId  Int
  holePattern HolePattern

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  finishRequired Boolean @default(false)

  allowedFinishes TemplateVariantFinish[]

  @@id([templateId, holePattern])
}

model TemplateSizeFinishPrice {
  templateId Int
  sizeId     Int
  finish     Finish
  price Int
  skuCode              String?

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  size     Size     @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  @@id([templateId, sizeId, finish])
}

model FinishVariant {
  id       Int                     @id @default(autoincrement())
  code     String                  @unique
  label    String
  variants TemplateVariantFinish[]
}

model TemplateVariantFinish {
  templateId  Int
  holePattern HolePattern
  finishId    Int

  variant TemplateVariant @relation(fields: [templateId, holePattern], references: [templateId, holePattern], onDelete: Cascade)
  finish  FinishVariant   @relation(fields: [finishId], references: [id], onDelete: Cascade)

  @@id([templateId, holePattern, finishId])
}

// ====== ЗАКАЗЫ ======

model Order {
  id                String      @id @default(cuid())
  number            String      @unique
  customerName      String?
  customerPhone     String?
  customerEmail     String?
  intakePoint       String?
  delivery          String?
  intakeDate        DateTime?
  approveNeeded     Boolean     @default(false)
  orderStatus       OrderStatus @default(DRAFT)
  orderNumber       String?     @unique
  currency          Currency    @default(RUB)
  includedInInvoice Boolean     @default(false)
  invoiceId         String?
  invoiceName       String?
  invoicePublicationHtmlUrl       String?

  items OrderItem?

  customerId String?
  customer   User?   @relation("CustomerOrders", fields: [customerId], references: [id])

  managerId String?
  manager   User?   @relation("ManagerOrders", fields: [managerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoice           Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([orderStatus, createdAt])
  @@index([customerId, createdAt])
  @@index([invoiceId])
  pendingUploads PendingUpload[]
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String @unique
  templateId Int

  sizeId          Int?
  holePattern     HolePattern?
  frameId         Int?
  backgroundId    Int?
  finish          Finish?
  comment         String?
  discussComment  String?
  discussComments DiscussComment[]
  approveNeeded   Boolean          @default(false)
  retouchNeeded   Boolean          @default(false)
  approvalStage   ApprovalStage    @default(NOT_STARTED)
  approved        Boolean          @default(false)
  skuCode         String?
  goldType         String?

  templateCode      String
  templateLabel     String
  templateFullTitle String?

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Restrict)

  size       Size?       @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  frame      Frame?      @relation(fields: [frameId], references: [id], onDelete: Restrict)
  background Background? @relation(fields: [backgroundId], references: [id], onDelete: Restrict)

  persons OrderItemPerson[]
  assets  OrderItemAsset[]  @relation("OrderItemToAssets")

  dateOfBirth DateTime?
  dateOfDeath DateTime?
  firstName   String?
  middleName  String?
  lastName    String?

  dateOfBirthSecondPerson DateTime?
  dateOfDeathSecondPerson DateTime?
  firstNameSecondPerson   String?
  middleNameSecondPerson  String?
  lastNameSecondPerson    String?

  managerActionNeeded Boolean?
  userActionNeeded    Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([templateId])
  @@index([sizeId])
  @@index([frameId])
  @@index([backgroundId])
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String?
  phone        String?
  legalName    String?
  address      String?
  inn          String?
  kontragentId String?
  role         Role    @default(CUSTOMER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerOrders Order[] @relation("CustomerOrders")
  managedOrders  Order[] @relation("ManagerOrders")

  notifyChannel  NotifyChannel?
  telegramChatId String?

  refreshSessions RefreshSession[]
}

model RefreshSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OrderItemPerson {
  id     String @id @default(cuid())
  itemId String

  lastName   String?
  firstName  String?
  middleName String?

  birthDate DateTime?
  deathDate DateTime?

  item OrderItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model OrderItemAsset {
  id          String @id @default(cuid())
  orderItemId String

  orderItem OrderItem @relation("OrderItemToAssets", fields: [orderItemId], references: [id], onDelete: Cascade)

  stage AssetStage @default(ORIGINAL)

  derivedFromId String?
  derivedFrom   OrderItemAsset?  @relation("AssetDerivation", fields: [derivedFromId], references: [id], onDelete: Cascade)
  derivatives   OrderItemAsset[] @relation("AssetDerivation")

  storage StorageType @default(s3)

  path String?

  bucket      String?
  key         String?
  thumbKey    String?
  contentType String?
  size        Int?
  etag        String?

  kind    AssetKind @default(PHOTO)
  primary Boolean   @default(false)

  originalName String?
  fileName     String?

  createdAt DateTime @default(now())

  @@index([orderItemId, createdAt])
}

model MaterialHolePrice {
  material     Material @id
  perHoleMinor Int      @default(0)
}

model DiscussComment {
  id          String     @id @default(cuid())
  text        String
  date        DateTime   @default(now())
  OrderItem   OrderItem? @relation(fields: [orderItemId], references: [id])
  orderItemId String?
}

model PendingUpload {
  id           String              @id @default(cuid())
  orderId      String
  itemId       String?
  userId       String?

  bucket       String
  key          String              @unique

  originalName String?
  contentType  String?
  size         Int?
  etag         String?

  status       PendingUploadStatus @default(PENDING)
  mode         AssetStage   @default(ORIGINAL)
  retouchOf    String?

  createdAt    DateTime            @default(now())
  expiresAt    DateTime
  attachedAt   DateTime?
  deletedAt    DateTime?
  lastError    String?

  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([expiresAt, status])
  @@index([itemId])
}

model Invoice {
  id             String   @id
  name           String?
  status         InvoiceStatus @default(UNPAID)

  totalMinor     Int      @default(0)
  paidMinor      Int      @default(0)

  description    String?

  createdAtRemote DateTime?
  updatedAtRemote DateTime?

  lastCheckedAt  DateTime?
  nextCheckAt    DateTime?
  paidAt         DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders         Order[]

  @@index([status, nextCheckAt])
  @@index([paidAt])
}
