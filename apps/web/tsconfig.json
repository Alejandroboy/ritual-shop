{
  "compilerOptions": {
    "target": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@repo/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@repo/types": [
        "../../packages/types/src/index.ts"
      ],
      "@repo/config": [
        "../../packages/config/src/index.ts"
      ],
      "@utils": [
        "./src/utils/index.ts"
      ],
      "@state": [
        "./src/state/index.ts"
      ],
      "@types": [
        "./src/types/index.ts"
      ]
    },
    "jsx": "react-jsx",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
