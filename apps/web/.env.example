# ===== apps/web — переменные окружения Next.js =====
# Реальный файл — apps/web/.env.local (в .gitignore).
# Скопировать: cp apps/web/.env.example apps/web/.env.local

# SSR → API (локальный yarn dev)
API_BASE=http://localhost:3001/api
# Браузер → API. Локально и в проде за Caddy обычно относительный путь:
NEXT_PUBLIC_API_BASE=/api
# Rewrites в next.config.ts
INTERNAL_API_ORIGIN=http://localhost:3001
# 1 — web в Docker (тогда origin по умолчанию http://api:3001)
# на VPS в .env.local:
#   API_BASE=http://api:3001/api
#   INTERNAL_API_ORIGIN=http://api:3001
#   DOCKER=1
DOCKER=
