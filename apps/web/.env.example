# ===== apps/web — переменные окружения Next.js =====
# Реальный файл — apps/web/.env.local (в .gitignore).

# Базовый URL API для серверных запросов (SSR), напр. http://localhost:3001/api или http://api:3001/api в Docker
API_BASE=
# Базовый URL API для браузера; в проде за Caddy — /api (встраивается в бандл при сборке)
NEXT_PUBLIC_API_BASE=
# Адрес API для rewrites в next.config.ts (по умолчанию http://localhost:3001, при DOCKER=1 — http://api:3001)
INTERNAL_API_ORIGIN=
# 1 — приложение запущено в Docker (влияет на адрес API по умолчанию)
DOCKER=
